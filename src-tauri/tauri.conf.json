{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebGlobe",
  "version": "0.1.0",
  "identifier": "com.webglobe.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @webglobe/ui dev",
    "beforeBuildCommand": "pnpm --filter @webglobe/ui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../packages/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WebGlobe",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
