FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    file \
    build-essential \
    libwebkit2gtk-4.1-dev \
    libxdo-dev \
    libssl-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libgtk-3-dev \
    pkg-config \
    ca-certificates \
    clang \
    lld \
    llvm \
    nsis \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9 --activate

RUN cargo install tauri-cli --version "^2" --locked

# Best-effort Windows cross-compile support (see docs/adr and Makefile
# build-windows target) - Tauri does not officially support this path;
# bundling (installer) generally still requires a native Windows/CI runner.
RUN rustup target add x86_64-pc-windows-msvc \
    && cargo install cargo-xwin --locked

WORKDIR /workspace

COPY package.json pnpm-workspace.yaml ./
COPY packages/core/package.json packages/core/package.json
COPY packages/map/package.json packages/map/package.json
COPY packages/storage-indexeddb/package.json packages/storage-indexeddb/package.json
COPY packages/storage-sqlite/package.json packages/storage-sqlite/package.json
COPY packages/storage-remote/package.json packages/storage-remote/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY e2e/playwright/package.json e2e/playwright/package.json

RUN pnpm install --frozen-lockfile || pnpm install

COPY . .

CMD ["cargo", "tauri", "build"]
